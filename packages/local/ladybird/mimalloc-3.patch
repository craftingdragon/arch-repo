-// A mimalloc heap belongs to the thread that made it: only that thread may allocate from it, but any thread may free
-// its memory. When the thread exits, mimalloc deletes its heaps, and what is still allocated stays valid until freed.
+// mimalloc 3 heaps can be shared. Each thread uses its own allocation context
+// within the backing heap for each partition.
 static constexpr size_t PARTITION_COUNT = to_underlying(HeapPartition::String) + 1;
-AK_TLS_INITIAL_EXEC static thread_local constinit mi_heap_t* s_partition_heaps[PARTITION_COUNT] {};
+AK_TLS_INITIAL_EXEC static thread_local constinit mi_theap_t* s_partition_heaps[PARTITION_COUNT] {};

-static mi_heap_t* heap_for_partition(HeapPartition partition)
+static mi_theap_t* heap_for_partition(HeapPartition partition)
 {
     if (partition == HeapPartition::General)
-        return mi_heap_get_default();
-    auto*& heap = s_partition_heaps[to_underlying(partition)];
-    if (!heap) [[unlikely]]
-        heap = mi_heap_new();
+        return mi_theap_get_default();
+
+    static struct BackingHeaps {
+        mi_heap_t* heaps[PARTITION_COUNT] {};
+
+        BackingHeaps()
+        {
+            for (size_t i = 1; i < PARTITION_COUNT; ++i)
+                heaps[i] = mi_heap_new();
+        }
+    } const backing_heaps;
+
+    auto index = to_underlying(partition);
+    auto*& heap = s_partition_heaps[index];
+    if (!heap) [[unlikely]] {
+        if (auto* backing_heap = backing_heaps.heaps[index])
+            heap = mi_heap_theap(backing_heap);
+    }
     return heap;
 }

