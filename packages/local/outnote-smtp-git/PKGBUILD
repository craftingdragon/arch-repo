# Maintainer: craftingDragon7 <info@craftingdragon.ch>
pkgname=outnote-smtp-git
pkgver=0.2.1.r12.g9f3a217
pkgrel=1
pkgdesc='Local SMTP and CardDAV bridge for OutNote and Microsoft 365'
arch=('any')
url='https://github.com/craftingdragon/outnote-smtp'
license=('MIT')
depends=('python>=3.10' 'python-outnote>=1.3' 'python-outnote<2'
         'python-aiosmtpd>=1.4.6' 'python-aiosmtpd<2' 'radicale>=3.8.3' 'radicale<4')
makedepends=('git' 'python-build' 'python-installer' 'python-hatchling')
provides=("outnote-smtp=${pkgver}")
conflicts=('outnote-smtp')
# Manually advance the reviewed commit to trigger a cached-repository rebuild.
_commit=9f3a217d302dd10c992f9e3ea91a2cf85a0f9a7e
source=("outnote-smtp::git+https://github.com/craftingdragon/outnote-smtp.git#commit=${_commit}"
        'outnote-smtp.service')
sha256sums=('SKIP' 'be8047540b72904f3338ba156f8c126a629e2ebf1fb6a2f0992433a7676d88dd')

pkgver() {
  cd outnote-smtp
  local version
  version=$(python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd outnote-smtp
  python -m build --wheel --no-isolation
}

package() {
  cd outnote-smtp
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/outnote-smtp.service" \
    "$pkgdir/usr/lib/systemd/user/outnote-smtp.service"
}
